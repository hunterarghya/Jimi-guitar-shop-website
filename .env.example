# Environment Variables Configuration
# Copy to .env and fill in with real values

# Application
APP_NAME=Jimi - Guitar Shop Platform
APP_VERSION=1.0.0
ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000
RELOAD=true

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=jimi
POSTGRES_USER=postgres
POSTGRES_PASSWORD=xxx

# MongoDB
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DB=jimi
MONGO_USER=mongodb
MONGO_PASSWORD=xxx

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=xxx

# JWT
SECRET_KEY=xxx-change-in-production-to-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth
GOOGLE_CLIENT_ID=xxx
GOOGLE_CLIENT_SECRET=xxx

# Razorpay
RAZORPAY_KEY_ID=xxx
RAZORPAY_KEY_SECRET=xxx

# ImageKit
IMAGEKIT_PRIVATE_KEY=xxx
IMAGEKIT_PUBLIC_KEY=xxx
IMAGEKIT_URL_ENDPOINT=xxx

# Email (Gmail or other SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=xxx
SMTP_PASSWORD=xxx
SENDER_EMAIL=noreply@jimi.local

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Security
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]
CSRF_ENABLED=true

# Geolocation
SHOP_RADIUS_KM=10.0
SHOP_LATITUDE=28.6139
SHOP_LONGITUDE=77.2090

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
